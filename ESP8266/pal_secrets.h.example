#ifndef PAL_SECRETS_H
#define PAL_SECRETS_H

/* =====================================================================
 *  pal_secrets.h.example  ——  私有配置模板（本模板文件可以入库）
 * ---------------------------------------------------------------------
 *  使用方法：
 *    1. 复制本文件为同目录下的 pal_secrets.h
 *         copy pal_secrets.h.example pal_secrets.h      (Windows)
 *         cp   pal_secrets.h.example pal_secrets.h      (Linux/macOS)
 *    2. 在 pal_secrets.h 里填入你自己的真实配置。
 *
 *  说明：pal_secrets.h 已在 .gitignore 中忽略，不会被提交；
 *        因此你的 WiFi 密码和巴法云私钥不会泄露到仓库里。
 * ===================================================================== */

#define WIFI_SSID   "your_wifi_ssid"          /* 你的 WiFi 名称 */
#define WIFI_PASS   "your_wifi_password"      /* 你的 WiFi 密码 */
#define BEMFA_UID   "your_bemfa_private_key"  /* 巴法云私钥(控制台右上角) */

#endif /* PAL_SECRETS_H */
